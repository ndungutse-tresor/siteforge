# Copy to .env and fill in what you have. Everything is optional locally; missing keys switch that feature off.
# On Vercel, set these in Project Settings -> Environment Variables (DATABASE_URL, SESSION_SECRET and CRON_SECRET are required there).

PORT=3100

# Database. Empty = a local Postgres kept in data/pglite (no install needed).
# Supabase: Connect -> Transaction pooler, e.g. postgres://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Supabase Storage for business photos. Empty = photos are kept in the database.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PHOTO_BUCKET=photos
# Signs login cookies (32+ random characters). Empty locally = a random key in data/secret.key.
SESSION_SECRET=
# Supabase pg_cron sends this to /api/cron/work and /api/cron/daily (32+ random characters; same value in db/supabase.sql).
CRON_SECRET=
# Public address previews are served from, e.g. https://yourbrand.rw
BASE_URL=http://localhost:3100
BRAND_NAME=SiteForge
# Where recipients can ask to stop (ICT Law 24/2016 requires this in every marketing message)
OPT_OUT_CONTACT=WhatsApp 07xx xxx xxx or reply STOP

# Google Places API (New) - enrichment only, fetched live, never stored except place_id
GOOGLE_PLACES_API_KEY=

# Claude API - content generation. Without it a plain fallback copy is used.
ANTHROPIC_API_KEY=

# DeepSeek - step-by-step company problem analysis shown and saved in the admin Problems tab.
DEEPSEEK_API_KEY=

# Vercel - deploy each approved site as its own Vercel project. Without it, sites are served by SiteForge at /sites/<slug>/.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT=siteforge-sites

# First-run admin (or use: npm run create-admin -- <username>)
ADMIN_USER=
ADMIN_PASSWORD=

# Client portal (/portal/): the MTN MoMo number clients pay to, and the name they will see on the transfer.
# Clients pay ADVANCE_PERCENT (default 50) before work starts and the rest when you mark the work finished.
MOMO_PAY_NUMBER=
MOMO_PAY_NAME=
# MoMo Pay merchant code: the portal shows a QR code that opens the dialer with *182*8*1*<code>#
MOMO_MERCHANT_CODE=
MOMO_MERCHANT_NAME=
ADVANCE_PERCENT=50
