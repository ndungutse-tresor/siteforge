# Copy to .env and fill in what you have. Everything is optional; missing keys switch that feature off.

PORT=3100
# Public address previews are served from, e.g. https://yourbrand.rw
BASE_URL=http://localhost:3100
BRAND_NAME=SiteForge
# Where recipients can ask to stop (ICT Law 24/2016 requires this in every marketing message)
OPT_OUT_CONTACT=WhatsApp 07xx xxx xxx or reply STOP

# Google Places API (New) - enrichment only, fetched live, never stored except place_id
GOOGLE_PLACES_API_KEY=

# Claude API - content generation. Without it a plain fallback copy is used.
ANTHROPIC_API_KEY=

# Vercel - deploy approved sites. Without it sites are only served locally under /preview/.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT=siteforge-sites

# First-run admin (or use: npm run create-admin -- <username>)
ADMIN_USER=
ADMIN_PASSWORD=

# Client portal (/portal/): the MTN MoMo number clients pay to, and the name they will see on the transfer.
# Clients pay ADVANCE_PERCENT (default 50) before work starts and the rest when you mark the work finished.
MOMO_PAY_NUMBER=
MOMO_PAY_NAME=
# MoMo Pay merchant code: the portal shows a QR code that opens the dialer with *182*8*1*<code>#
MOMO_MERCHANT_CODE=
MOMO_MERCHANT_NAME=
ADVANCE_PERCENT=50
